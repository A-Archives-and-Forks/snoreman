{
  "expo": {
    "name": "Snoreman",
    "slug": "snoreman",
    "version": "1.1.11",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "snoreman",
    "locales": {
      "zh-Hans": { "CFBundleDisplayName": "呼噜娃" },
      "zh-Hant": { "CFBundleDisplayName": "呼噜娃" },
      "ja": { "CFBundleDisplayName": "ぐうたん" },
      "ko": { "CFBundleDisplayName": "쿨쿨박" }
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snoreman.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "需要使用麦克风来录制睡眠时的音频，以分析打鼾情况",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.snoreman.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C63FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "需要使用麦克风来录制睡眠时的音频，以分析打鼾情况"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-android-localized-name"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c13e55bf-8773-499d-809b-4a746405c36e"
      }
    },
    "owner": "timqian_2"
  }
}
